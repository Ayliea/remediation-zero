# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Cloud -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Reasoning runs on Vertex / Agent Platform, never the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models -----------------------------------------------------------------
REASONING_MODEL=gemini-3.5-flash
# Deliberately a different model family from the reasoning model. Do not
# change this to a Gemini model: cross-family review is an architectural
# decision, not an implementation detail.
REVIEWER_MODEL=gemma-<version>

# --- Clock ------------------------------------------------------------------
# "real" for wall clock, "sim" for the accelerated demo. real_ts is wall clock
# in both modes and is never falsified.
SIM_CLOCK_MODE=real

# --- Deployed agent ---------------------------------------------------------
# Stable and explicit. This resource is updated in place and never deleted or
# recreated: a long-running session with days of real elapsed time is tied to
# it and cannot be regenerated before the deadline.
AGENT_RESOURCE_NAME=
