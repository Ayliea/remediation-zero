# The scheduled worker. One image, deployed twice: WORKER_AGENT selects the
# agent and the service account differs per deployment, so neither instance
# holds the other's access.
#
# Separate from the console image rather than shared with it. The console
# claims to ship no write path, and the only way that claim stays true is for
# the container that writes to be a different container.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# The agents' logic, the tools they use, and the push endpoint. No prompts and
# no model clients: nothing on this path reasons.
COPY worker/ ./worker/
COPY scripts/__init__.py scripts/chase.py scripts/exception.py ./scripts/
COPY tools/ ./tools/

ENV PORT=8080
CMD exec uvicorn worker.app:app --host 0.0.0.0 --port ${PORT} --workers 1
