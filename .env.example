# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Google Cloud -----------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Reasoning runs on Vertex / Agent Platform, never the Gemini Developer API.
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models -----------------------------------------------------------------
REASONING_MODEL=gemini-3.5-flash
# Deliberately a different model family from the reasoning model. Do not
# change this to a Gemini model: cross-family review is an architectural
# decision, not an implementation detail.
REVIEWER_MODEL=gemma-<version>

# --- Clock ------------------------------------------------------------------
# "real" for wall clock, "sim" for the accelerated demo. real_ts is wall clock
# in both modes and is never falsified.
SIM_CLOCK_MODE=real

# --- Deployed agent ---------------------------------------------------------
# Stable and explicit. This resource is updated in place and never deleted or
# recreated: a long-running session with days of real elapsed time is tied to
# it and cannot be regenerated before the deadline.
#
# Leave AGENT_ENGINE_ID empty ONLY for the very first deploy, which requires
# ./scripts/deploy-agent.sh --create. Record the printed ID here immediately
# afterwards. Deploying with it empty creates a second engine and orphans the
# session; deploy-agent.sh refuses rather than letting that happen silently.
AGENT_ENGINE_ID=

# Printed by ./scripts/session-init.py on first run. Recorded here so the rest
# of the build addresses that session rather than creating another.
ORCHESTRATOR_SESSION_ID=

# Recorded by ./scripts/session-init.py. The console reads it to show how long
# the session has been alive in wall clock, which is the one figure in this
# project that can only be earned by waiting.
SESSION_CREATED_REAL_TS=

# --- Guardrails -------------------------------------------------------------
# The Model Armor template screening untrusted text before it reaches any
# reasoning context. With MODEL_ARMOR_ENABLED=true and no template configured
# the screener fails closed, which is the intended direction: unscreened text
# never reaches a model because a filter was missing.
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_ENABLED=true

# --- Ticket delivery --------------------------------------------------------
# Where chase files its issues, as "owner/name". Unset, the fleet reaches
# exactly the same decisions and logs `delivery_disabled` rather than failing:
# Firestore is the record and the tracker is a delivery of it.
#
# Use a repository dedicated to this. The issues are generated from a synthetic
# corpus and each one says so in its body, but they should not land among real
# work regardless.
GITHUB_TICKET_REPO=

# A token with `repo` scope. Never commit it; this file is the example and .env
# is gitignored. In the deployed workers it is not an environment variable at
# all — it lives in Secret Manager as `rz-github-token`, readable only by
# rz-chase, and Cloud Run fetches it at request time.
#
#   gh auth token            # if you use the GitHub CLI
GITHUB_TOKEN=

# Where the Agent Engine itself lives. Deliberately different from
# GOOGLE_CLOUD_LOCATION above, and the difference is not cosmetic: the models
# are served from `global` and return 404 from a named region, while Agent
# Engine deploys into a named one. Addressing the engine with the model's
# location returns "The ReasoningEngine does not exist", which reads like the
# engine was lost. It was not.
AGENT_ENGINE_LOCATION=us-central1

# --- Deployed agent internals -----------------------------------------------
# Agent Engine reserves GOOGLE_CLOUD_PROJECT and refuses to deploy when it
# appears in an environment config, so the deployed agent is told the project
# under a name that is certain to be accepted. Locally this is unnecessary;
# GOOGLE_CLOUD_PROJECT above is read instead. Set in
# agents/orchestrator/.agent_engine_config.json for the cloud.
RZ_FIRESTORE_PROJECT=

# The engine's own identifiers, which it needs to address its Memory Bank
# scope. AGENT_ENGINE_ID above is read locally; these are the names the
# deployed engine is given, because some standard names are reserved and refuse
# to deploy. Set in agents/orchestrator/.agent_engine_config.json for the
# cloud; leaving them blank here is correct.
RZ_AGENT_ENGINE_ID=
RZ_AGENT_ENGINE_LOCATION=

# Not for this file. WORKER_AGENT selects which agent a scheduled worker runs
# and is set per-service by ./scripts/deploy-worker.sh, so that one image can
# be deployed twice under two different identities. A worker with it unset
# refuses every tick rather than guessing which agent it is.
